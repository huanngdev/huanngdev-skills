{
  "$schema": "../../../node_modules/oxlint/configuration_schema.json",
  "extends": [
    "./base.json"
  ],
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "react",
    "jsx-a11y"
  ],
  "env": {
    "browser": true
  },
  "overrides": [
    {
      "files": [
        "**/vite.config.ts",
        "**/vitest.config.ts"
      ],
      "rules": {
        "import/no-default-export": "off"
      }
    }
  ],
  "rules": {
    "react/react-in-jsx-scope": "off"
  }
}
