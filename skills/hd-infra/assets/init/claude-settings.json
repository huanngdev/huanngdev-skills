{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "huanngdev-skills": {
      "source": { "source": "github", "repo": "huanngdev/huanngdev-skills" }
    }
  },
  "enabledPlugins": {
    "huanngdev@huanngdev-skills": true
  },
  "enabledMcpjsonServers": ["zod-docs", "better-auth", "tanstack", "shadcn", "playwright"],
  "permissions": {
    "allow": [
      "Bash(bun install)",
      "Bash(bun install --frozen-lockfile)",
      "Bash(bun run *)",
      "Bash(bun --bun vitest run *)",
      "Bash(bunx turbo run *)",
      "Bash(bunx --bun shadcn@latest add *)",
      "Bash(docker compose config *)",
      "Bash(docker compose up -d *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)"
    ],
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push * -f*)",
      "Bash(docker compose down *-v*)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.*.local)",
      "Read(./**/.env.production)"
    ]
  }
}
